---
import { formatDatetimeToText } from "../../utils/datetime-tools";

interface Props {
  frontmatter: PostFrontmatter;
}

const { frontmatter } = Astro.props as Props;

const getDatetimeInfo = () => {
  if (frontmatter.category === "clipping") {
    if (frontmatter.published) {
      return { label: "Published@ ", date: frontmatter.published };
    }
    return { label: "Saved@ ", date: frontmatter.saved };
  }
  return { label: "Created@ ", date: frontmatter.created };
};

const { label, date } = getDatetimeInfo();
---

<span class="text-sm">
  <span>{label}</span>
  <time>{formatDatetimeToText(date)}</time>
</span>
